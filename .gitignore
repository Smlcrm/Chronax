# Expanded campaign platform (datasets, per-run configs, analysis scripts,
# reference baselines). Lives in the private claude-md repo, not here; the
# public suite is benchmarks/config.yaml + benchmarks/neural/config.yaml.
benchmarks/benchmark_datasets/*
!benchmarks/benchmark_datasets/airline-passengers.csv
!benchmarks/benchmark_datasets/daily-total-female-births.csv
